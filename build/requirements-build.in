# Everything that goes into MediaConverter.exe, pinned for the release build.
# build\requirements-lock.txt is generated from this file (exact versions + SHA-256 hashes):
#
#   python -m pip install pip-tools
#   python -m piptools compile --pre --generate-hashes --allow-unsafe --strip-extras --no-header -o build\requirements-lock.txt build\requirements-build.in
#
# --pre is needed because yt-dlp publishes its site fixes as nightly ".dev" releases on PyPI.
#
-r ../requirements.txt
yt-dlp[default,curl-cffi]==2026.10.10.233141.dev0
pyinstaller==6.22.3
# Stable releases for everything else (--pre would otherwise pick betas):
curl-cffi==0.16.3
